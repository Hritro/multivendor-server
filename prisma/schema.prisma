generator client {
  provider = "prisma-client-js"
  // output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       Int     @id @default(autoincrement())
  email    String  @unique
  name     String
  address  String?
  photoURL String?
  phone    String?
  password String
  role     Role
}

enum Role {
  USER
  ADMIN
  SELLER
}
